# Blynk Cloud Configuration
# Template: Health Guard
# Datastreams: V0=HR, V1=SpO2, V2=temp, V3=fall, V4=GPS status, V5=lat, V6=lon, V7=BLE room
BLYNK_TOKEN=your_blynk_auth_token_here
BLYNK_SERVER=blynk.cloud

# Firebase Cloud Messaging (FCM) Credentials (Optional for local demo)
# Path to service account json or inline json
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CAREGIVER_FCM_TOKEN=

# App Configuration
APP_ENV=development
DEFAULT_REFRESH_INTERVAL=3
